<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Widget host declaration; binding always falls back to the system user-consent flow. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>
    <queries><package android:name="moe.shizuku.privileged.api"/><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/></intent><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
        <intent><action android:name="android.intent.action.DIAL"/></intent>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.APP_BROWSER"/></intent>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.APP_MESSAGING"/></intent>
        <intent><action android:name="android.media.action.STILL_IMAGE_CAMERA"/></intent>
    </queries>
    <application android:name=".ProjectionApp" android:label="@string/app_name" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:icon="@drawable/ic_projection">
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true"/>
        <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="${applicationId}.shizuku" android:multiprocess="false" android:exported="true" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"/>
        <activity android:name=".DesktopActivity" android:exported="true" android:excludeFromRecents="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <activity android:name=".DuoHomeActivity" android:exported="true" android:label="玻璃桌面"
            android:theme="@style/DuoHomeTheme" android:launchMode="singleTask" android:stateNotNeeded="false"
            android:taskAffinity="io.github.sixzleo.tabfold.projection.home" android:excludeFromRecents="true"
            android:resizeableActivity="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.HOME"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
        </activity>
        <activity android:name=".DuoSecondaryActivity" android:exported="true" android:label="玻璃桌面" android:theme="@style/DuoHomeTheme"
            android:launchMode="singleTop" android:taskAffinity="io.github.sixzleo.tabfold.projection.secondary" android:excludeFromRecents="true"
            android:resizeableActivity="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.SECONDARY_HOME"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
        </activity>
        <activity android:name=".DuoInnerActivity" android:exported="true" android:label="Duo Inner" android:theme="@style/DuoHomeTheme"
            android:launchMode="singleTask" android:taskAffinity="io.github.sixzleo.tabfold.projection.inner" android:excludeFromRecents="true"
            android:resizeableActivity="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"/>
        <activity android:name=".DuoCoverActivity" android:exported="true" android:label="Duo Cover" android:theme="@style/DuoHomeTheme"
            android:launchMode="singleTask" android:taskAffinity="io.github.sixzleo.tabfold.projection.cover" android:excludeFromRecents="true"
            android:resizeableActivity="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden"/>
        <activity android:name=".ProjectionActivity" android:exported="true" android:configChanges="screenSize|smallestScreenSize|orientation|screenLayout|density"/>
        <activity android:name=".AppBlacklistActivity" android:exported="false" android:label="应用黑名单"/>
        <activity android:name=".UpdateActivity" android:exported="false" android:label="检查更新"/>
        <activity android:name=".UpdateInstallActivity" android:exported="false" android:excludeFromRecents="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"/>
        <service android:name=".UpdateDownloadService" android:exported="false" android:foregroundServiceType="dataSync"/>
        <provider android:name=".UpdateApkProvider" android:authorities="${applicationId}.updates" android:exported="false" android:grantUriPermissions="true"/>
        <activity android:name=".CacheProbeActivity" android:exported="true"/>
        <activity android:name=".WirelessPairingActivity" android:exported="false" android:label="玻璃投影配对"
            android:taskAffinity="io.github.sixzleo.tabfold.projection.pairing" android:excludeFromRecents="false"
            android:resizeableActivity="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"/>
        <service android:name=".WirelessPairingService" android:exported="false" android:foregroundServiceType="shortService"/>
        <provider android:name=".ProjectionProvider" android:authorities="io.github.sixzleo.tabfold.projection.surface" android:exported="true"/>
        <service android:name=".ProjectionService" android:exported="true" android:label="@string/app_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/projection_accessibility"/>
        </service>
    </application>
</manifest>
